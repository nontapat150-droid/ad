# Local test clone — copy to .env.localtest (never use on production server)
# Used with: BOU_ENV=localtest npm run dev:localtest

PORT=3002
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=BOU_LOCAL_TEST

JWT_SECRET=local_test_only_change_me
JWT_EXPIRES_IN=8h

UPLOAD_DIR=uploads-localtest
MAX_FILE_SIZE_MB=10

FRONTEND_ORIGIN=http://localhost:5174

# Skip cron on local test to avoid duplicate reminders
ENABLE_CRON=false
