<Window x:Class="BoNotesInspector.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BO Notes Inspector" Width="1280" Height="850" MinWidth="1000" MinHeight="650" FontFamily="Leelawadee UI" FontSize="14" Background="#F3F5F5" Closing="OnClosing">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,7,5"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C6D2CE"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="6"/><Setter Property="BorderBrush" Value="#BBCBC4"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="6"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="18,10"/></Style>
 </Window.Resources>
 <DockPanel Margin="22">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BO Notes Inspector" FontSize="28" FontWeight="Bold" Foreground="#143F32"/><TextBlock Text="อ่าน Notes → ตรวจรายละเอียด → ส่งออก Excel → ยืนยันนำเข้า" Foreground="#53665E" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#E2EEE7" Padding="12,8" CornerRadius="6" VerticalAlignment="Center"><TextBlock Text="นำเข้าเป็นรายการรอตรวจ • ไม่ตัด SN" Foreground="#174E37"/></Border></Grid>
  <WrapPanel DockPanel.Dock="Top"><Button Content="ชุดใหม่" Click="NewBatch"/><Button Content="เปิดฉบับร่าง" Click="OpenBatch"/><Button Content="บันทึกฉบับร่าง" Click="SaveBatch"/><Button Content="เปิดโฟลเดอร์ชุดนี้" Click="OpenBatchFolder"/><TextBlock x:Name="BatchText" Margin="10,8,0,0"/></WrapPanel>
  <Border DockPanel.Dock="Bottom" Background="#E7EEEB" Padding="10" Margin="0,10,0,0"><TextBlock x:Name="StatusText" Text="เปิด LINE และ Notes ของกลุ่มงาน แล้วเลือกหน้าต่าง" TextWrapping="Wrap"/></Border>
  <TabControl x:Name="MainTabs" Background="White" BorderBrush="#D2DDD7">
   <TabItem Header="1  อ่าน Notes"><DockPanel Margin="15"><StackPanel DockPanel.Dock="Top">
    <WrapPanel><ComboBox x:Name="WindowsBox" Width="340" DisplayMemberPath="Label"/><Button Content="ค้นหาหน้าต่าง LINE" Click="RefreshWindows" Margin="8,0,0,5"/><TextBlock Text="ชื่อกลุ่ม" Margin="12,9,8,0"/><TextBox x:Name="GroupBox" Width="300"/></WrapPanel>
    <WrapPanel Margin="0,12,0,5"><TextBlock Text="เก็บไม่เกิน" Margin="0,8,8,0"/><TextBox x:Name="MaxPagesBox" Text="50" Width="60"/><TextBlock Text="หน้าจอ /" Margin="7,8"/><TextBox x:Name="MaxSecondsBox" Text="600" Width="70"/><TextBlock Text="วินาที" Margin="7,8,18,0"/><Button x:Name="StartButton" Content="เริ่มอ่านอัตโนมัติ" Click="StartRead" Background="#1D684A" Foreground="White"/><Button Content="พัก / หยุด" Click="StopRead"/></WrapPanel>
    <TextBlock Text="ใช้ LINE ด้านหน้าและปลดล็อกเครื่อง • กด Escape เพื่อหยุด • อ่านเฉพาะหน้าต่างที่เลือก • ภาพและร่างเก็บในเครื่อง" Foreground="#68776F" TextWrapping="Wrap" Margin="0,0,0,12"/></StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="ResultText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0"/><ScrollViewer Grid.Column="1"><Image x:Name="CaptureImage" Stretch="Uniform" VerticalAlignment="Top"/></ScrollViewer></Grid>
   </DockPanel></TabItem>
   <TabItem x:Name="ReviewTab" Header="2  ตรวจรายการ"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top">
    <WrapPanel><ComboBox x:Name="FilterTypeBox" Width="180" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="FilterChanged"/><TextBlock Text="วันทำงาน" Margin="10,8,7,0"/><DatePicker x:Name="FromDateBox" Width="130" SelectedDateChanged="FilterChanged"/><TextBlock Text="ถึง" Margin="7"/><DatePicker x:Name="ToDateBox" Width="130" SelectedDateChanged="FilterChanged"/><Button Content="ล้างตัวกรอง" Click="ClearFilters" Margin="7,0"/><Button Content="เลือกเฉพาะที่แสดง" Click="SelectVisible"/><Button Content="ยกเลิกทั้งหมด" Click="DeselectAll"/></WrapPanel>
    <WrapPanel Margin="0,8,0,8"><ComboBox x:Name="BatchTechBox" Width="250" DisplayMemberPath="FullName"/><Button Content="กำหนดช่างให้รายการที่เลือก" Click="AssignTechnician" Margin="8,0"/><TextBlock x:Name="ReviewCountText" VerticalAlignment="Center"/></WrapPanel></StackPanel>
    <Grid><Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition/></Grid.RowDefinitions>
     <DataGrid x:Name="DraftGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="SelectItem" HeadersVisibility="Column" RowHeaderWidth="0"><DataGrid.Columns><DataGridCheckBoxColumn Header="เลือก" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" Width="35"/><DataGridTextColumn Header="ประเภท" Binding="{Binding TypeName}" IsReadOnly="True" Width="130"/><DataGridTextColumn Header="วันทำงาน" Binding="{Binding JobDate}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="เลขเคส / Order" Binding="{Binding Reference}" IsReadOnly="True" Width="180"/><DataGridTextColumn Header="ช่าง" Binding="{Binding Technician}" IsReadOnly="True" Width="130"/><DataGridTextColumn Header="ผลตรวจ" Binding="{Binding State}" IsReadOnly="True" Width="*"/></DataGrid.Columns></DataGrid>
     <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,10,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="ข้อความที่จะนำเข้า (แก้ไขได้)" FontWeight="Bold"/><ComboBox x:Name="TypeBox" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="ChangeType" Margin="0,5"/><TextBlock x:Name="SourceText" TextWrapping="Wrap" Foreground="#607168" FontSize="12" Margin="0,0,0,5"/></StackPanel><Expander DockPanel.Dock="Bottom" Header="ดูข้อความ OCR เดิม" Margin="0,7,0,0"><TextBox x:Name="OriginalTextBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="110" VerticalScrollBarVisibility="Auto"/></Expander><TextBox x:Name="EditTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="EditChanged"/></DockPanel>
      <DockPanel Grid.Column="1" Margin="0,0,10,0"><StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><ComboBox x:Name="TechnicianBox" DisplayMemberPath="FullName" SelectionChanged="TechnicianChanged" ToolTip="โหลดรายชื่อช่างจากแท็บเชื่อม BO ad"/><CheckBox x:Name="TextCheck" Content="ตรวจข้อความทุกช่องกับภาพแล้ว" Margin="0,6"/><CheckBox x:Name="DateCheck" Content="ยืนยันวันที่ทำงานแล้ว" Margin="0,3"/><CheckBox x:Name="SnCheck" Content="ตรวจ SN ทุกตัว / ยืนยันว่าไม่มี SN" Margin="0,3"/><CheckBox x:Name="BoundaryCheck" Content="ตรวจว่าเป็นโพสต์เดียวและข้อความครบ" Margin="0,3"/><Button Content="บันทึกผลตรวจรายการนี้" Click="SaveReview" Background="#E3EFE8" Margin="0,8,0,0"/></StackPanel><DataGrid x:Name="FieldsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="หัวข้อเดิม" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="ค่า" Binding="{Binding Value}" Width="1.3*"/></DataGrid.Columns></DataGrid></DockPanel>
      <DockPanel Grid.Column="2"><WrapPanel DockPanel.Dock="Top"><ComboBox x:Name="EvidenceBox" Width="155" SelectionChanged="SelectEvidence"/><Button Content="−" Click="ZoomOut"/><Button Content="+" Click="ZoomIn"/></WrapPanel><TextBlock DockPanel.Dock="Bottom" x:Name="ParseWarningsText" TextWrapping="Wrap" Foreground="#975D17" Margin="0,7,0,0"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Image x:Name="EvidenceImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"><Image.LayoutTransform><ScaleTransform x:Name="EvidenceScale" ScaleX="0.7" ScaleY="0.7"/></Image.LayoutTransform></Image></ScrollViewer></DockPanel>
     </Grid>
    </Grid>
   </DockPanel></TabItem>
   <TabItem Header="3  สรุปและ Excel"><DockPanel Margin="18"><WrapPanel DockPanel.Dock="Top"><Button x:Name="ExportButton" Content="ส่งออก Excel ของรายการที่เลือก" Click="ExportExcel"/><Button x:Name="EvidenceZipButton" Content="ส่งออก ZIP พร้อมหลักฐาน" Click="ExportEvidence"/></WrapPanel><TextBox x:Name="SummaryTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></DockPanel></TabItem>
   <TabItem Header="4  เชื่อม BO ad / นำเข้า"><StackPanel Margin="18"><TextBlock Text="เชื่อมบัญชีผู้ดูแล BO ad เมื่อพร้อมนำเข้า — เก็บ token ในหน่วยความจำเท่านั้น" FontWeight="Bold"/><WrapPanel Margin="0,15,0,8"><TextBlock Text="เว็บไซต์" Margin="0,8,8,0"/><TextBox x:Name="ServerBox" Text="https://bonusais.com" Width="250"/><TextBlock Text="บัญชี" Margin="12,8,8,0"/><TextBox x:Name="UsernameBox" Width="150"/><TextBlock Text="รหัสผ่าน" Margin="12,8,8,0"/><PasswordBox x:Name="PasswordBox" Width="150" Padding="6"/></WrapPanel><WrapPanel><Button x:Name="ConnectButton" Content="เชื่อมต่อและโหลดรายชื่อช่าง" Click="ConnectServer"/><Button x:Name="ImportButton" Content="ตรวจชุดข้อมูลและยืนยันนำเข้า" Click="ImportSelected" Background="#1D684A" Foreground="White"/><Button Content="ออกจากบัญชี" Click="DisconnectServer"/></WrapPanel><TextBlock x:Name="ConnectionText" Text="ยังไม่เชื่อมต่อ — อ่าน ตรวจ และส่งออก Excel ได้โดยไม่ต้องล็อกอิน" Margin="0,12" TextWrapping="Wrap"/><TextBox x:Name="ImportHistoryBox" IsReadOnly="True" AcceptsReturn="True" Height="350" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
